package-as: TrainWrecker

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .agents
  - .github
  - .gitignore
  - .luarc.json
  - .markdownlint-cli2.jsonc
  - .markdownlint.json
  - .pkgmeta
  - .prettierrc
  - .pylintrc
  - .types
  - README.md
  - docs
  - scripts
  - tests
  - types.lua
